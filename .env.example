# Copy this file to `.env` (Prisma CLI and Next.js both read `.env`).

# Postgres connection string.
#  - Local (docker compose up -d):  postgresql://postgres:postgres@localhost:6500/ajaia_docs?schema=public
#  - Neon (free): use the *direct* (non-pooled) connection string, ending in ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:6500/ajaia_docs?schema=public"

# Secret used to sign session cookies. Use a long random string in production
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
SESSION_SECRET="change-me-to-a-long-random-string"
